# ==============================================================================
# Nowhere Subscription Backend Configuration Example
# ==============================================================================

# Required: The exact Android application package name
ANDROID_PACKAGE_NAME=com.nowhere.gps.locationchanger

# Required: Comma-separated list of allowed Google Play subscription product IDs
GOOGLE_PLAY_PRODUCT_IDS=nowhere_premium,nowhere_premium_yearly

# HTTP Server Port (Cloud Run automatically injects PORT=8080)
PORT=8080

# Environment: production, development, or test
APP_ENV=production

# Logging Level: INFO or DEBUG
APP_LOG_LEVEL=INFO

# Maximum incoming HTTP request body size in bytes (Default: 16384 = 16KB)
MAX_REQUEST_BODY_BYTES=16384

# In-memory IP rate limiter: requests per second per IP (Default: 10.0)
RATE_LIMIT_RPS=10.0

# In-memory IP rate limiter: burst capacity per IP (Default: 20)
RATE_LIMIT_BURST=20

# Timeout in seconds for downstream Google Play Developer API calls (Default: 10)
REQUEST_TIMEOUT_SECONDS=10

# Vercel / Cloud Provider Credentials:
# Since Vercel runs outside Google Cloud, set one of the following in Vercel Dashboard -> Settings -> Environment Variables:
# 1. GOOGLE_CREDENTIALS_JSON: Paste the entire content of your service account JSON file.
# 2. GOOGLE_CREDENTIALS_BASE64: Base64-encoded string of the JSON key (avoids multiline formatting issues).
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}
# GOOGLE_CREDENTIALS_BASE64=ewogICJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCI...

# Local development only: Path to local Google Cloud service account JSON key.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
