<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_surface"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Bottom Sheet Drag Handle -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="18dp"
            android:background="@drawable/bg_sheet_handle" />

        <!-- Glowing Star Badge HUD Header -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="12dp">

            <View
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_glass_pill" />

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_favorite"
                app:tint="@color/badge_warning_text"
                tools:ignore="ContentDescription" />
        </FrameLayout>

        <!-- Title & Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.01"
            android:text="@string/app_review_enjoying_nowhere"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/app_review_your_5star_rating_on_google"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- 5-Star Interactive Rating Selector Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/surface_glass_inner"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/stroke_glass_specular"
            app:strokeWidth="1.2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvRatingPrompt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_review_tap_stars_to_rate"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Five Star Row -->
                <LinearLayout
                    android:id="@+id/layoutStarRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivStar1"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="4dp"
                        android:src="@drawable/ic_favorite"
                        app:tint="@color/badge_warning_text"
                        tools:ignore="ContentDescription" />

                    <ImageView
                        android:id="@+id/ivStar2"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="4dp"
                        android:src="@drawable/ic_favorite"
                        app:tint="@color/badge_warning_text"
                        tools:ignore="ContentDescription" />

                    <ImageView
                        android:id="@+id/ivStar3"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="4dp"
                        android:src="@drawable/ic_favorite"
                        app:tint="@color/badge_warning_text"
                        tools:ignore="ContentDescription" />

                    <ImageView
                        android:id="@+id/ivStar4"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="4dp"
                        android:src="@drawable/ic_favorite"
                        app:tint="@color/badge_warning_text"
                        tools:ignore="ContentDescription" />

                    <ImageView
                        android:id="@+id/ivStar5"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginHorizontal="3dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="4dp"
                        android:src="@drawable/ic_favorite"
                        app:tint="@color/badge_warning_text"
                        tools:ignore="ContentDescription" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Primary Action Button: Rate on Google Play -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRateOnPlayStore"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/primary"
            android:letterSpacing="0.02"
            android:text="@string/app_review_rate_on_google_play"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_favorite"
            app:iconTint="@color/white" />

        <!-- Remind Me Later Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRemindLater"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/surface_card_elevated"
            android:text="@string/app_review_remind_me_later"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="14dp" />

        <!-- Never Ask Again Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNeverAskAgain"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginTop="4dp"
            android:text="@string/app_review_never_ask_again"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
