<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="28dp"
        android:paddingBottom="24dp">

        <!-- Glowing Circular Icon Illustration Container -->
        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginBottom="24dp">

            <!-- Outer Subtle Ring -->
            <View
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/bg_status_pill"
                android:backgroundTint="@color/surface_card" />

            <!-- Inner Circle -->
            <View
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_status_pill"
                android:backgroundTint="@color/surface_card_elevated" />

            <!-- Center Icon -->
            <ImageView
                android:id="@+id/ivSlideGraphic"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_bolt"
                app:tint="@color/primary_bright"
                tools:ignore="ContentDescription" />
        </FrameLayout>

        <!-- Step Pill Badge -->
        <TextView
            android:id="@+id/tvSlideBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_pill"
            android:backgroundTint="@color/badge_active_bg"
            android:letterSpacing="0.08"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:text="STEP 1 OF 3 • DEVELOPER OPTIONS"
            android:textColor="@color/primary_bright"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Bold Headline -->
        <TextView
            android:id="@+id/tvSlideHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:letterSpacing="0.01"
            android:lineSpacingExtra="2dp"
            android:text="Select Nowhere as Mock Location App"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Description -->
        <TextView
            android:id="@+id/tvSlideDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Android requires Nowhere to be selected as your system Mock Location provider in Developer Settings."
            android:textColor="@color/text_secondary"
            android:textSize="13.5sp" />

        <!-- Dedicated Step Action Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStepAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/stroke_subtle"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Status Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivStepStatusIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_warning_circle"
                        tools:ignore="ContentDescription" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStepStatusTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Status: Not Configured"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStepStatusDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Action required to enable mock GPS simulation"
                            android:textColor="@color/text_muted"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Primary Action Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStepAction"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="@color/surface_card_elevated"
                    android:letterSpacing="0.04"
                    android:text="Open Developer Options"
                    android:textColor="@color/primary_bright"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_settings"
                    app:iconGravity="textStart"
                    app:iconTint="@color/primary_bright"
                    app:strokeColor="@color/stroke_subtle"
                    app:strokeWidth="1dp" />

                <!-- Helpful Guide Subtext / Tip -->
                <TextView
                    android:id="@+id/tvStepTip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="2dp"
                    android:text="💡 Tip: If Developer Options is hidden on your phone, go to Settings &gt; About Phone and tap 'Build Number' 7 times."
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>