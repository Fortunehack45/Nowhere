<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_solid_dialog"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <ImageView
            android:id="@+id/ivHeaderIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/ic_info"
            app:tint="@color/primary" />

        <TextView
            android:id="@+id/tvStabilityTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.04"
            android:text="@string/stability_info_title"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStabilitySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="@string/stability_info_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Explanatory Card (Solid Elevated) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_solid_elevated"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivSparkleNotice"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_sparkle"
                    app:tint="@color/primary" />

                <TextView
                    android:id="@+id/tvOemNoticeHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Why does Google Maps turn ash?"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStabilityBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/stability_info_desc"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Action 1: Pin Widget to Home Screen -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPinWidget"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/primary"
            android:letterSpacing="0.04"
            android:minHeight="48dp"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:text="@string/stability_info_pin_widget"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_widgets"
            app:iconGravity="textStart"
            app:iconTint="@color/white" />

        <!-- Action 2: Browse Widget Gallery -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBrowseGallery"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.03"
            android:minHeight="44dp"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:text="@string/stability_info_browse_gallery"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_layers"
            app:iconGravity="textStart"
            app:iconTint="@color/text_primary"
            app:strokeColor="@color/stroke_subtle" />

        <!-- Action 3: Battery Unrestricted -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBatteryUnrestricted"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.03"
            android:minHeight="44dp"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:text="@string/stability_info_battery_unrestricted"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_bolt"
            app:iconGravity="textStart"
            app:iconTint="@color/text_primary"
            app:strokeColor="@color/stroke_subtle" />

        <!-- Action 4: Location Allow All The Time -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLocationAllTime"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.03"
            android:minHeight="44dp"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:text="@string/stability_info_location_all_time"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_my_location"
            app:iconGravity="textStart"
            app:iconTint="@color/text_primary"
            app:strokeColor="@color/stroke_subtle" />

        <!-- Action 5: OEM Settings (Transsion / Phone Master) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOemSettings"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.03"
            android:minHeight="44dp"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:text="@string/stability_info_oem_settings"
            android:textColor="@color/badge_warning_text"
            android:textSize="12sp"
            android:visibility="gone"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_warning"
            app:iconGravity="textStart"
            app:iconTint="@color/badge_warning_text"
            app:strokeColor="@color/badge_warning_text" />

        <!-- Action 6: Dismiss -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDismiss"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="40dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/stability_info_dismiss"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
