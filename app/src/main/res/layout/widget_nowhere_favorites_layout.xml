<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/favoritesWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_widget_glass"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: Logo, Title, Active Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_favorite"
            android:tint="@color/primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:letterSpacing="0.08"
            android:text="QUICK DESTINATIONS"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Glowing Active Indicator Pill -->
        <TextView
            android:id="@+id/tvFavWidgetStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="STANDBY"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3 Quick Destination Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnFavSlot1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_button_primary"
            android:gravity="center"
            android:text="Paris"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnFavSlot2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_button"
            android:gravity="center"
            android:text="Tokyo"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnFavSlot3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_button"
            android:gravity="center"
            android:text="New York"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Bar: Coordinates Readout, Edit Destinations, Stop -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvFavCurrentLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="37.77490°, -122.41940°"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

        <!-- Edit Destinations Button (Opens Settings to Customize Countries) -->
        <TextView
            android:id="@+id/btnFavWidgetEdit"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_widget_button"
            android:gravity="center"
            android:paddingHorizontal="8dp"
            android:text="Edit"
            android:textColor="@color/primary_bright"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Stop Simulation Button -->
        <TextView
            android:id="@+id/btnFavWidgetStop"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_widget_button"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="Stop"
            android:textColor="@color/primary"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
