<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/routeWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_widget_glass"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Bar: Logo, Title, Speed, Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_route"
            android:tint="@color/primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:letterSpacing="0.08"
            android:text="ROUTE SIMULATOR"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWidgetRouteSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_pill"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="60 KM/H"
            android:textColor="@color/primary_bright"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWidgetRouteStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_status_pill"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="ACTIVE"
            android:textColor="@color/badge_active_text"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- FROM and TO Route Origin & Destination Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_widget_button"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Origin: From -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="FROM:"
                android:textColor="@color/primary_bright"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRouteOrigin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Victoria Island, Lagos"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Destination: To -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:letterSpacing="0.05"
                android:text="TO:"
                android:textColor="@color/primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRouteDestination"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Lekki Phase 1, Lagos"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Live Distance Telemetry (Covered / Total / Remaining) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvWidgetRouteDistance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Covered: 0.0 km / 0.0 km"
            android:textColor="@color/text_primary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWidgetRouteRemaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.0 km left"
            android:textColor="@color/primary"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Route Progress Bar -->
    <ProgressBar
        android:id="@+id/pbWidgetRoute"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/primary" />

    <!-- Bottom Controls & Coordinates -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvWidgetRouteWaypoints"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="Leg 2 / 5 • 45%"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

        <!-- Pause / Resume Button -->
        <TextView
            android:id="@+id/btnWidgetRoutePlayPause"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="@drawable/bg_widget_button_primary"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="Pause"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Stop Button -->
        <TextView
            android:id="@+id/btnWidgetRouteStop"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_widget_button"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="Stop"
            android:textColor="@color/primary"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
