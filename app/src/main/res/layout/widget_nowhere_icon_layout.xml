<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widgetIconRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="2dp">

    <!-- App Icon Centerpiece (100% Exact Matching App Icon) -->
    <FrameLayout
        android:id="@+id/flIconContainer"
        android:layout_width="56dp"
        android:layout_height="56dp">

        <ImageView
            android:id="@+id/ivWidgetAppIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher" />

        <!-- Live Simulation Active Pulse Dot Indicator -->
        <ImageView
            android:id="@+id/ivIconStatusDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:src="@drawable/bg_dot_emerald"
            android:visibility="gone" />
    </FrameLayout>

    <!-- App Name Label (Matching Android Home Screen Shortcut Title) -->
    <TextView
        android:id="@+id/tvWidgetAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:shadowColor="#CC000000"
        android:shadowDx="1.0"
        android:shadowDy="1.0"
        android:shadowRadius="2.0"
        android:text="@string/app_name"
        android:textColor="@color/widget_icon_text"
        android:textSize="12sp"
        android:textStyle="normal" />

</LinearLayout>
