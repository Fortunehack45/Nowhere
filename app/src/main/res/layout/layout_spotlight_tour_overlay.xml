<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Apple-Minimal Floating Tooltip Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSpotlightTooltip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginHorizontal="20dp"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="22dp"
        app:cardElevation="12dp"
        app:strokeColor="@color/stroke_subtle"
        app:strokeWidth="1.2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Step Badge & Icon Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivSpotlightStepIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_search"
                    app:tint="@color/primary"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvSpotlightStepBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_status_pill"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:paddingHorizontal="10dp"
                    android:text="1 OF 5"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSpotlightSkip"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="8dp"
                    android:text="Skip"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Step Title -->
            <TextView
                android:id="@+id/tvSpotlightStepTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:letterSpacing="-0.01"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Global Address &amp; Coordinates" />

            <!-- Step Description -->
            <TextView
                android:id="@+id/tvSpotlightStepDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.25"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="Search any city, landmark, street address, or exact GPS coordinates to instantly center the map." />

            <!-- Action Buttons Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/pbSpotlightProgress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:layout_weight="1"
                    app:indicatorColor="@color/primary"
                    app:trackColor="@color/stroke_subtle"
                    app:trackCornerRadius="3dp"
                    app:trackThickness="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSpotlightNext"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:backgroundTint="@color/primary"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="110dp"
                    android:paddingHorizontal="20dp"
                    android:text="Next"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
