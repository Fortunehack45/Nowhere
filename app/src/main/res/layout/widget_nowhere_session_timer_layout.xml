<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sessionTimerWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_widget_glass"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Bar: Logo, Title, Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivWidgetTimerLogo"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_launcher_monochrome"
            android:tint="@color/primary"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvWidgetTimerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:letterSpacing="0.08"
            android:text="SESSION TIMER"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWidgetSessionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="ACTIVE"
            android:textColor="@color/badge_active_text"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center Card: Large Countdown Clock & Total Allocation -->
    <LinearLayout
        android:id="@+id/cardWidgetTimerBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_widget_button"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.06"
            android:text="TIME REMAINING"
            android:textColor="@color/text_muted"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWidgetTimeRemaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="monospace"
            android:text="01:59:42"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvWidgetTotalAllocated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Total Allocated: 2h 00m"
            android:textColor="@color/primary"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Controls: Extend +1h and Open App -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btnWidgetExtendOneHour"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <ImageView
                android:id="@+id/ivWidgetExtendIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_bolt"
                android:tint="@color/primary"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="+2 Hours (Ad)"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnWidgetOpenApp"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <ImageView
                android:id="@+id/ivWidgetOpenAppIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_play"
                android:tint="@color/primary"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Open Nowhere"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
