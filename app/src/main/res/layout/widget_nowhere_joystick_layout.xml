<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/joystickWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_widget_glass"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: Title, Speed Toggle, Open App -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_joystick"
            android:tint="@color/primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:letterSpacing="0.08"
            android:text="JOYSTICK D-PAD"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnJoystickWidgetSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_pill"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="15 KM/H"
            android:textColor="@color/primary_bright"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- D-Pad Directional Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="vertical">

        <!-- North Button (Up) -->
        <ImageView
            android:id="@+id/btnJoyUp"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_widget_button_primary"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_drop_up"
            android:tint="@color/white" />

        <!-- Middle Row: West, Center (Stop), East -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginVertical="4dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnJoyLeft"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_widget_button_primary"
                android:padding="6dp"
                android:src="@drawable/ic_arrow_left"
                android:tint="@color/white" />

            <ImageView
                android:id="@+id/btnJoyCenter"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_widget_button"
                android:padding="8dp"
                android:src="@drawable/ic_stop"
                android:tint="@color/primary" />

            <ImageView
                android:id="@+id/btnJoyRight"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_widget_button_primary"
                android:padding="6dp"
                android:src="@drawable/ic_arrow_right"
                android:tint="@color/white" />
        </LinearLayout>

        <!-- South Button (Down) -->
        <ImageView
            android:id="@+id/btnJoyDown"
            android:layout_width="48dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_widget_button_primary"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_drop_down"
            android:tint="@color/white" />
    </LinearLayout>

    <!-- Coordinates Readout -->
    <TextView
        android:id="@+id/tvJoyCoords"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:text="37.77490°, -122.41940°"
        android:textColor="@color/text_muted"
        android:textSize="10sp" />
</LinearLayout>
