<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_glass"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/ic_nowhere_logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:letterSpacing="0.04"
        android:text="MOCK LOCATION SETUP"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="4dp"
        android:text="To simulate GPS system-wide across all apps, Android requires Nowhere to be selected as your Mock Location Provider:\n\n1. Tap 'Open Developer Options'.\n2. Scroll down to 'Select mock location app'.\n3. Choose 'Nowhere'."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- 1-Tap Auto-Grant for Rooted Devices -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAutoGrantRoot"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/surface_card_elevated"
        android:letterSpacing="0.03"
        android:text="Auto-Grant via Root (1-Tap)"
        android:textColor="@color/primary_bright"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_bolt"
        app:iconTint="@color/primary_bright"
        app:strokeColor="@color/stroke_red_glow"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenDeveloperSettings"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/primary"
        android:letterSpacing="0.03"
        android:text="Open Developer Options"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:cornerRadius="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDismiss"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:text="I'll configure later"
        android:textColor="@color/text_muted" />

</LinearLayout>
