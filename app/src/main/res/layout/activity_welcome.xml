<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootWelcome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_dark">

    <!-- Subtle Top Brand Header -->
    <LinearLayout
        android:id="@+id/layoutWalkthroughHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="20dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_nowhere_logo"
            tools:ignore="ContentDescription" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:letterSpacing="0.16"
            android:text="NOWHERE"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Multi-Step Walkthrough Pager -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pagerWalkthrough"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/layoutDotsIndicator"
        app:layout_constraintTop_toBottomOf="@id/layoutWalkthroughHeader" />

    <!-- 3-Dot Page Indicator -->
    <LinearLayout
        android:id="@+id/layoutDotsIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/layoutWalkthroughBottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/viewDot1"
            android:layout_width="22dp"
            android:layout_height="7dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_walkthrough_dot_active" />

        <View
            android:id="@+id/viewDot2"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_walkthrough_dot_inactive" />

        <View
            android:id="@+id/viewDot3"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_walkthrough_dot_inactive" />
    </LinearLayout>

    <!-- Bottom Action Bar: SKIP and NEXT buttons -->
    <LinearLayout
        android:id="@+id/layoutWalkthroughBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/btnWalkthroughSkip"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:paddingHorizontal="16dp"
            android:text="SKIP"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWalkthroughNext"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:minWidth="124dp"
            android:backgroundTint="@color/surface_card_elevated"
            android:letterSpacing="0.04"
            android:paddingHorizontal="20dp"
            android:text="NEXT"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="99dp"
            app:icon="@drawable/ic_chevron_right"
            app:iconGravity="textEnd"
            app:iconTint="@color/white"
            app:strokeColor="@color/stroke_subtle"
            app:strokeWidth="1dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
