<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_dark">

    <!-- OpenStreetMap View -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Header Glass Bar: Branding + Status Badge + Settings + Search Bar -->
    <LinearLayout
        android:id="@+id/layoutTopHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- App Brand Header & Live Status Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_nowhere_logo"
                tools:ignore="ContentDescription" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:letterSpacing="0.08"
                android:text="NOWHERE"
                android:textColor="@color/primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- IP Shield HUD Pill -->
            <LinearLayout
                android:id="@+id/layoutIpShieldBadge"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_status_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:id="@+id/ivShieldIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_launcher_monochrome"
                    app:tint="@color/text_muted"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvIpShieldBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:letterSpacing="0.04"
                    android:text="IP: DIRECT"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Status Badge Pill -->
            <LinearLayout
                android:id="@+id/layoutStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_status_pill"
                android:gravity="center"
                android:paddingHorizontal="12dp">

                <View
                    android:id="@+id/viewStatusDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_status_pill"
                    android:backgroundTint="@color/text_muted" />

                <TextView
                    android:id="@+id/tvStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:letterSpacing="0.06"
                    android:text="STANDBY"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnHeaderSettings"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_settings"
                app:tint="@color/primary"
                tools:ignore="ContentDescription" />
        </LinearLayout>

        <!-- Search Bar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutSearchBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_glass"
            android:paddingHorizontal="14dp">

            <ImageView
                android:id="@+id/ivSearchIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_search"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/text_muted"
                tools:ignore="ContentDescription" />

            <EditText
                android:id="@+id/etAddressSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:background="@null"
                android:hint="@string/title_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnClearSearch"
                app:layout_constraintStart_toEndOf="@id/ivSearchIcon"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/btnClearSearch"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_clear"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="ContentDescription" />

            <ProgressBar
                android:id="@+id/pbSearchLoading"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/primary"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Unified Search & History Dropdown -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSearchResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_search_dropdown"
            android:elevation="16dp"
            android:maxHeight="260dp"
            android:padding="4dp"
            android:visibility="gone" />

        <!-- Mock App Setup Banner -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bannerMockSetup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/surface_card_elevated"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/badge_warning_text"
            app:strokeWidth="1dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/badge_warning_text"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvBannerMockText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/warning_mock_provider_required"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBannerEnable"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="@color/badge_warning_text"
                    android:text="Configure"
                    android:textColor="@color/surface_dark"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:cornerRadius="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Revoked Runtime Error Banner -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bannerError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/surface_card_elevated"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/badge_error_text"
            app:strokeWidth="1dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvBannerErrorText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    tools:text="Error occurred" />

                <Button
                    android:id="@+id/btnBannerErrorDismiss"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Dismiss"
                    android:textColor="@color/badge_error_text" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Right Quick Floating Tools Stack -->
    <LinearLayout
        android:id="@+id/layoutSideButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_card_glass"
        android:orientation="vertical"
        android:padding="6dp"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutTopHeader"
        app:layout_constraintVertical_bias="0.3">

        <ImageButton
            android:id="@+id/fabZoomIn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Zoom In"
            android:src="@drawable/ic_add"
            app:tint="@color/text_primary" />

        <View
            android:layout_width="28dp"
            android:layout_height="1dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="4dp"
            android:background="@color/stroke_subtle" />

        <ImageButton
            android:id="@+id/fabZoomOut"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Zoom Out"
            android:src="@drawable/ic_remove"
            app:tint="@color/text_primary" />

        <View
            android:layout_width="28dp"
            android:layout_height="1dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="4dp"
            android:background="@color/stroke_subtle" />

        <ImageButton
            android:id="@+id/fabMyLocation"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Center Target"
            android:src="@drawable/ic_my_location"
            app:tint="@color/text_primary" />

        <View
            android:layout_width="28dp"
            android:layout_height="1dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="4dp"
            android:background="@color/stroke_subtle" />

        <ImageButton
            android:id="@+id/fabSaveFavorite"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Save Location Bookmark"
            android:src="@drawable/ic_favorite"
            app:tint="@color/badge_warning_text" />

        <View
            android:layout_width="28dp"
            android:layout_height="1dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="4dp"
            android:background="@color/stroke_subtle" />

        <ImageButton
            android:id="@+id/fabOpenFavorites"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Saved Destinations"
            android:src="@drawable/ic_favorite"
            app:tint="@color/primary" />
    </LinearLayout>

    <!-- Floating Radar Joystick Overlay -->
    <com.fakegps.mocklocation.ui.custom.JoystickView
        android:id="@+id/joystickOverlay"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomContainer"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom HUD Controls Container -->
    <LinearLayout
        android:id="@+id/layoutBottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_glass"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Mode Switcher Tabs -->
        <RadioGroup
            android:id="@+id/rgModeTabs"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_segmented_tab"
            android:checkedButton="@id/rbFixedMode"
            android:orientation="horizontal"
            android:padding="3dp">

            <RadioButton
                android:id="@+id/rbFixedMode"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_segmented_pill_item"
                android:button="@null"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:text="@string/tab_fixed"
                android:textColor="@color/color_segmented_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rbRouteMode"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_segmented_pill_item"
                android:button="@null"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:text="@string/tab_route"
                android:textColor="@color/color_segmented_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rbJoystickMode"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_segmented_pill_item"
                android:button="@null"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:text="@string/tab_joystick"
                android:textColor="@color/color_segmented_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </RadioGroup>

        <!-- Coordinates & Telemetry Readout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvFixedCoords"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:text="37.77490° N, 122.41940° W"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTelemetryMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="READY • ±1.8m • 18 SAT"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Dynamic Controls: Fixed Mode -->
        <LinearLayout
            android:id="@+id/layoutFixedControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFixedToggle"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/primary"
                    android:letterSpacing="0.04"
                    android:text="@string/btn_start_teleport"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_teleport"
                    app:iconTint="@color/white" />
            </LinearLayout>

            <!-- Persistent Location Injector Status & Boot Toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Auto-Inject on Device Boot"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchPersistentInjection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    app:thumbTint="@color/primary"
                    app:trackTint="@color/stroke_subtle" />
            </LinearLayout>
        </LinearLayout>

        <!-- Dynamic Controls: Route Mode -->
        <LinearLayout
            android:id="@+id/layoutRouteControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvWaypointsCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 Waypoints (Tap map to plot)"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchLoopRoute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Loop"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    app:thumbTint="@color/primary"
                    app:trackTint="@color/stroke_subtle" />
            </LinearLayout>

            <!-- Transport Mode Selector (Foot, Vehicle, Aircraft, Ship) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.04"
                android:text="TRANSPORT MODE"
                android:textColor="@color/primary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgTransportMode"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_segmented_tab"
                android:checkedButton="@id/rbTransportVehicle"
                android:orientation="horizontal"
                android:padding="2dp">

                <RadioButton
                    android:id="@+id/rbTransportFoot"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segmented_pill_item"
                    android:button="@null"
                    android:gravity="center"
                    android:text="Foot"
                    android:textColor="@color/color_segmented_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/rbTransportVehicle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segmented_pill_item"
                    android:button="@null"
                    android:gravity="center"
                    android:text="Vehicle"
                    android:textColor="@color/color_segmented_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/rbTransportAircraft"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segmented_pill_item"
                    android:button="@null"
                    android:gravity="center"
                    android:text="Aircraft"
                    android:textColor="@color/color_segmented_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/rbTransportShip"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segmented_pill_item"
                    android:button="@null"
                    android:gravity="center"
                    android:text="Ship"
                    android:textColor="@color/color_segmented_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </RadioGroup>

            <!-- Route Speed Slider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvRouteSpeedLabel"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:text="20 KM/H"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderRouteSpeed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:value="20.0"
                    android:valueFrom="1.0"
                    android:valueTo="1000.0"
                    android:stepSize="1.0" />
            </LinearLayout>

            <!-- Route Advanced Action Bar (Saved Routes, Save Route, Reverse, GPX, Clear) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSavedRoutesDrawer"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:backgroundTint="@color/surface_card_elevated"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="14dp"
                        android:text="Routes"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="19dp"
                        app:icon="@drawable/ic_folder"
                        app:iconSize="16dp"
                        app:iconTint="@color/primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSaveCurrentRoute"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="@color/surface_card_elevated"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="14dp"
                        android:text="Save"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="19dp"
                        app:icon="@drawable/ic_save"
                        app:iconSize="16dp"
                        app:iconTint="@color/primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReverseRoute"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="@color/surface_card_elevated"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="14dp"
                        android:text="Reverse"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="19dp"
                        app:icon="@drawable/ic_refresh"
                        app:iconSize="16dp"
                        app:iconTint="@color/primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnImportGpx"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="@color/surface_card_elevated"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="14dp"
                        android:text="GPX"
                        android:textColor="@color/primary_bright"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="19dp"
                        app:icon="@drawable/ic_gpx"
                        app:iconSize="16dp"
                        app:iconTint="@color/primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearRoute"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:backgroundTint="@color/surface_card_elevated"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="14dp"
                        android:text="Clear"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:cornerRadius="19dp"
                        app:icon="@drawable/ic_delete"
                        app:iconSize="16dp"
                        app:iconTint="@color/text_muted" />
                </LinearLayout>
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRouteToggle"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/primary"
                    android:text="Start Route"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_play"
                    app:iconTint="@color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRoutePause"
                    android:layout_width="wrap_content"
                    android:layout_height="50dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/surface_card_elevated"
                    android:text="Pause"
                    android:textColor="@color/white"
                    android:visibility="gone"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_pause"
                    app:iconTint="@color/white" />
            </LinearLayout>
        </LinearLayout>

        <!-- Dynamic Controls: Joystick Mode -->
        <LinearLayout
            android:id="@+id/layoutJoystickControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvJoystickSpeedLabel"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:text="MAX: 10 KM/H"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderJoystickSpeed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:value="10.0"
                    android:valueFrom="2.0"
                    android:valueTo="60.0"
                    android:stepSize="2.0" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnJoystickToggle"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/primary"
                    android:text="Engage Joystick"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_play"
                    app:iconTint="@color/white" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFloatingOverlayToggle"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/surface_card_elevated"
                    android:text="Floating"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_joystick"
                    app:iconTint="@color/primary" />
            </LinearLayout>
        </LinearLayout>

        <!-- AdMob Adaptive Banner Container -->
        <FrameLayout
            android:id="@+id/adBannerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
