<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/searchWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_widget_glass"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header: Logo, Title, Live Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivSearchWidgetLogo"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_search"
            android:tint="@color/primary"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvSearchWidgetTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:letterSpacing="0.08"
            android:text="QUICK SEARCH &amp; TELEPORT"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSearchWidgetStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_pill"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="STANDBY"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Search Bar Card (1-Tap to Open & Search Anywhere) -->
    <LinearLayout
        android:id="@+id/btnSearchWidgetSearch"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_widget_button"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_search"
            android:tint="@color/text_muted" />

        <TextView
            android:id="@+id/tvSearchWidgetHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Search city, address or coordinates..."
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Quick Mode Actions & Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSearchWidgetCoords"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="37.77490°, -122.41940°"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

        <!-- 1-Tap Teleport -->
        <FrameLayout
            android:id="@+id/layoutSearchWidgetTeleport"
            android:layout_width="wrap_content"
            android:layout_height="28dp">

            <ImageView
                android:id="@+id/ivSearchWidgetTeleportBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/bg_widget_button_small_white"
                android:tint="@color/primary"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/btnSearchWidgetTeleport"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="Teleport"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Stop Simulation -->
        <TextView
            android:id="@+id/btnSearchWidgetStop"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_widget_button"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="Stop"
            android:textColor="@color/primary"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
