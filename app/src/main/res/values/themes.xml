<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.MockLocation" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorSecondary">@color/primary</item>
        <item name="colorSecondaryContainer">@color/surface_card_elevated</item>
        <item name="colorOnSecondaryContainer">@color/primary</item>
        <item name="colorTertiary">@color/primary_bright</item>
        <item name="android:windowBackground">@color/surface_dark</item>
        <item name="android:statusBarColor">@color/surface_dark</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="sliderStyle">@style/Widget.Nowhere.Slider</item>
        <item name="materialSwitchStyle">@style/Widget.Nowhere.Switch</item>
        <item name="bottomSheetDialogTheme">@style/Theme.Nowhere.BottomSheetDialog</item>
    </style>

    <style name="Theme.Nowhere.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Nowhere.BottomSheet</item>
    </style>

    <style name="Widget.Nowhere.BottomSheet" parent="Widget.Material3.BottomSheet">
        <item name="backgroundTint">@color/surface_dark</item>
    </style>

    <style name="Widget.Nowhere.Slider" parent="Widget.Material3.Slider">
        <item name="thumbColor">@color/white</item>
        <item name="trackColorActive">@color/primary</item>
        <item name="trackColorInactive">@color/stroke_subtle</item>
        <item name="haloColor">@color/transparent</item>
        <item name="thumbRadius">9dp</item>
        <item name="trackHeight">6dp</item>
    </style>

    <style name="Widget.Nowhere.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/switch_thumb_selector</item>
        <item name="trackTint">@color/switch_track_selector</item>
    </style>
</resources>
