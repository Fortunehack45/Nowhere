<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Location Permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_MOCK_LOCATION" tools:ignore="MockLocation,ProtectedPermissions" />

    <!-- Foreground Service & Notifications -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Boot, Background Resilience & Floating Overlay -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" tools:ignore="ProtectedPermissions" />

    <!-- Network for Map Tiles & Geocoding -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".MockLocationApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.MockLocation">

        <!-- Feature Walkthrough Onboarding Carousel -->
        <activity
            android:name=".ui.FeatureWalkthroughActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.MockLocation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- System & Permission Readiness Screen -->
        <activity
            android:name=".ui.WelcomeActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.MockLocation" />

        <!-- Main Simulation HUD Dashboard -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustPan" />

        <!-- Advanced Engine & Display Settings -->
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustPan" />

        <service
            android:name=".service.MockLocationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <service
            android:name=".service.FloatingJoystickService"
            android:enabled="true"
            android:exported="false" />

        <service
            android:name=".vpn.NowhereVpnService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Virtual IP privacy tunnel" />
        </service>

        <receiver
            android:name=".service.BootCompletedReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- Google Mobile Ads (AdMob) App ID -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-5191202278112313~3868363285" />

        <!-- Home Screen App Widget: Quick Actions -->
        <receiver
            android:name=".ui.widget.NowhereAppWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.fakegps.mocklocation.ACTION_UPDATE_WIDGET_STATE" />
                <action android:name="com.fakegps.mocklocation.ACTION_WIDGET_TELEPORT" />
                <action android:name="com.fakegps.mocklocation.ACTION_WIDGET_JOYSTICK" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_nowhere_info" />
        </receiver>

        <!-- Home Screen App Widget: Live Route Simulator -->
        <receiver
            android:name=".ui.widget.NowhereRouteWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.fakegps.mocklocation.ACTION_UPDATE_ROUTE_WIDGET" />
                <action android:name="com.fakegps.mocklocation.ACTION_ROUTE_WIDGET_PLAY_PAUSE" />
                <action android:name="com.fakegps.mocklocation.ACTION_ROUTE_WIDGET_STOP" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_nowhere_route_info" />
        </receiver>

        <!-- Home Screen App Widget: Quick Search & Teleport Launcher -->
        <receiver
            android:name=".ui.widget.NowhereSearchWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.fakegps.mocklocation.ACTION_UPDATE_SEARCH_WIDGET" />
                <action android:name="com.fakegps.mocklocation.ACTION_SEARCH_WIDGET_TELEPORT" />
                <action android:name="com.fakegps.mocklocation.ACTION_SEARCH_WIDGET_STOP" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_nowhere_search_info" />
        </receiver>

        <!-- Home Screen App Widget: Quick Favorites & Destinations -->
        <receiver
            android:name=".ui.widget.NowhereFavoritesWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.fakegps.mocklocation.ACTION_UPDATE_FAV_WIDGET" />
                <action android:name="com.fakegps.mocklocation.ACTION_FAV_TELEPORT" />
                <action android:name="com.fakegps.mocklocation.ACTION_FAV_STOP" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_nowhere_favorites_info" />
        </receiver>

        <!-- Home Screen App Widget: 1x1 Functional App Icon Widget -->
        <receiver
            android:name=".ui.widget.NowhereIconWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.fakegps.mocklocation.ACTION_UPDATE_ICON_WIDGET" />
                <action android:name="com.fakegps.mocklocation.ACTION_ICON_WIDGET_CLICK" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_nowhere_icon_info" />
        </receiver>

        <!-- Home Screen App Widget: IP Privacy Shield Widget -->
        <receiver
            android:name=".ui.widget.NowhereVpnWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.fakegps.mocklocation.ACTION_UPDATE_VPN_WIDGET" />
                <action android:name="com.fakegps.mocklocation.ACTION_VPN_WIDGET_TOGGLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_nowhere_vpn_info" />
        </receiver>

        <!-- Home Screen App Widget: Location Weather Radar Widget -->
        <receiver
            android:name=".ui.widget.NowhereWeatherWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.fakegps.mocklocation.ACTION_UPDATE_WEATHER_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_nowhere_weather_info" />
        </receiver>

        <!-- Home Screen App Widget: Session Duration & Countdown Widget -->
        <receiver
            android:name=".ui.widget.NowhereSessionTimerWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.fakegps.mocklocation.ACTION_UPDATE_SESSION_WIDGET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_nowhere_session_timer_info" />
        </receiver>

    </application>

</manifest>
