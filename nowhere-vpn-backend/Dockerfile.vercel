# ==============================================================================
# Nowhere VPN Backend — Vercel Container on Fluid Compute
# ==============================================================================

# Stage 1: Build Static Go Binary
FROM golang:1.22-alpine AS builder

WORKDIR /src

RUN apk add --no-cache git ca-certificates tzdata

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w -extldflags '-static'" \
    -o /app/nowhere-vpn-backend main.go

# Stage 2: Minimal Production Image
FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata openssh-client wireguard-tools iproute2 iptables sudo bash

WORKDIR /app

RUN mkdir -p /app/config /secrets /tmp

COPY --from=builder /app/nowhere-vpn-backend /app/nowhere-vpn-backend
COPY config/ /app/config/

# Environment Defaults (Vercel automatically sets PORT dynamically)
ENV PORT=8080
ENV CONFIG_DIR=/app/config
ENV SSH_DEFAULT_KEY=/secrets/nowhere_deploy.pem

EXPOSE 8080

ENTRYPOINT ["/app/nowhere-vpn-backend"]
